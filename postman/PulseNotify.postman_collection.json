                ]
              }
            }
          ]
        },
        {
          "name": "10 Bob lists alerts - sees none of Alice's (200, empty list)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bob_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/alerts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "alerts",
                ""
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 (not 404)\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Empty list - alerts are scoped to the user\", () => pm.expect(pm.response.json()).to.eql([]));"
                ]
              }
            }
          ]
        },
        {
          "name": "11 Mock price feed - valid route (200, no auth)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/flights/price/?route=DEL-BOM",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "flights",
                "price",
                ""
              ],
              "query": [
                {
                  "key": "route",
                  "value": "DEL-BOM"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Route echoed and price within DEL-BOM range 3000-7000\", () => {",
                  "  pm.expect(j.route).to.eql(\"DEL-BOM\");",
                  "  pm.expect(j.price).to.be.within(3000, 7000);",
                  "});"
                ]
              }
            }
          ]
        },
