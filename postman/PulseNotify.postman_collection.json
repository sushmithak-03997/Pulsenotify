    {
      "name": "Admin scenarios (16-17)",
      "item": [
        {
          "name": "16 Login as admin (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login",
                ""
              ]
            },
            "description": "Requires an admin account: python manage.py createsuperuser (superusers get role=admin automatically), or set role=admin in pgAdmin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_user}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 (create the admin first: python manage.py createsuperuser)\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Role is admin\", () => pm.expect(j.role).to.eql(\"admin\"));",
                  "pm.collectionVariables.set(\"admin_token\", j.access);"
                ]
              }
            }
          ]
        },
        {
          "name": "17 Admin summary (200 + statistics)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/summary/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "summary",
                ""
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Has all summary keys\", () => {",
                  "  [\"total_alerts\",\"active_alerts\",\"triggered_alerts\",\"total_notifications\",\"top_routes\"].forEach(k => pm.expect(j).to.have.property(k));",
                  "  pm.expect(j.top_routes).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"Counts are consistent\", () => pm.expect(j.active_alerts + j.triggered_alerts).to.be.at.most(j.total_alerts));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "admin_user",
      "value": "admin"
    },
    {
      "key": "admin_password",
      "value": "admin12345"
    }
  ]
}