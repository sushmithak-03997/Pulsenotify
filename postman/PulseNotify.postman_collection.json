{
  "info": {
    "name": "PulseNotify API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the folders in order (Runner). Core scenarios need no setup; Admin scenarios need an admin account (see variables admin_user / admin_password)."
  },
  "item": [
    {
      "name": "Core scenarios (01-15)",
      "item": [
        {
          "name": "01 Register Alice (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                ""
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{alice_user}}\",\n  \"password\": \"securepass\",\n  \"email\": \"alice@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const run = Date.now();",
                  "pm.collectionVariables.set(\"alice_user\", \"alice_\" + run);",
                  "pm.collectionVariables.set(\"bob_user\", \"bob_\" + run);",
                  "pm.collectionVariables.set(\"mallory_user\", \"mallory_\" + run);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Returns username, access token and role=user\", () => {",
                  "  pm.expect(j.username).to.eql(pm.collectionVariables.get(\"alice_user\"));",
                  "  pm.expect(j.access).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(j.role).to.eql(\"user\");",
                  "});",
                  "pm.collectionVariables.set(\"alice_token\", j.access);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Register Bob - second user for scoping tests (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": [
                "{{base_url}}"
