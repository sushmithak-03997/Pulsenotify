        {
          "name": "07 Create price alert (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{alice_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/alerts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "alerts",
                ""
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": \"DEL\",\n  \"destination\": \"BOM\",\n  \"threshold_price\": 4500\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Alert is active, owned by caller, fields normalised\", () => {",
                  "  pm.expect(j.status).to.eql(\"active\");",
                  "  pm.expect(j.origin).to.eql(\"DEL\");",
                  "  pm.expect(j.destination).to.eql(\"BOM\");",
                  "  pm.expect(parseFloat(j.threshold_price)).to.eql(4500);",
                  "});",
                  "pm.collectionVariables.set(\"alert_id\", j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "08 List own alerts (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{alice_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/alerts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "alerts",
                ""
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test(\"Contains Alice's alert\", () => {",
                  "  pm.expect(list).to.be.an(\"array\");",
                  "  pm.expect(list.map(a => a.id)).to.include(parseInt(pm.collectionVariables.get(\"alert_id\")));",
                  "});"
                ]
              }
            }
          ]
        },
