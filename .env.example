# Copy to .env (cp .env.example .env) and change the secrets. NEVER commit .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=pulsenotify.settings.local
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (read by Django AND by docker-compose) ---
POSTGRES_DB=pulsenotify
POSTGRES_USER=pulse_user
POSTGRES_PASSWORD=pulse_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Internal mock price feed called by the check_prices task ---
PRICE_FEED_URL=http://localhost:8000/api/flights/price/

# --- pgAdmin (optional, docker-compose) ---
PGADMIN_EMAIL=admin@pulsenotify.com
PGADMIN_PASSWORD=admin
